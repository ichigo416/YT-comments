# Must match INTERNAL_TOKEN in server/.env. Generate with: openssl rand -hex 32
INTERNAL_TOKEN=openssl rand -hex 32
MODEL_PATH=../ml/artifacts/toxicity_baseline.joblib
# development | production (production REQUIRES MODEL_SHA256)
ENVIRONMENT=development

# Shared secret, must equal INTERNAL_API_TOKEN in server/.env. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=

# Folder containing toxicity_baseline.joblib and manifest.json
MODEL_DIR=../ml/artifacts

# SHA-256 of the model file ("sha256" in manifest.json). Keep it in your secret store.
MODEL_SHA256=

# Host headers accepted by this service (comma separated, no ports)
ALLOWED_HOSTS=localhost,127.0.0.1