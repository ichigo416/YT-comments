NODE_ENV=development
PORT=8080

# Where the FastAPI service listens (keep it on localhost / a private network).
INFERENCE_URL=http://127.0.0.1:8000

# Must match INTERNAL_TOKEN in inference/.env. Generate with: openssl rand -hex 32
INTERNAL_TOKEN=openssl rand -hex 32

# Comma-separated list of allowed browser origins.
# Load the unpacked extension, copy its ID from chrome://extensions, then set:
# ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=

# Set to 1 only when running behind exactly one reverse proxy (nginx, Cloudflare, ...),
# so rate limiting sees the real client IP.
TRUST_PROXY=0
